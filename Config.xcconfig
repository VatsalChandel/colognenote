// Config.xcconfig — base build configuration (committed).
//
// Real secret values live in Secrets.xcconfig, which is git-ignored.
// Copy Secrets.example.xcconfig -> Secrets.xcconfig and fill it in.
// The line below pulls those values in if the file exists (the "?" makes it optional
// so the project still opens on a fresh clone before setup).
//
// SUPABASE_PROJECT_REF / SUPABASE_ANON_KEY become build settings, which the app's
// Info.plist expands via $(...) substitution — see colognenote/Info.plist and
// SupabaseConfig.swift. Only the anon/public key is ever used.

#include? "Secrets.xcconfig"
