// Secrets.example.xcconfig — template (committed).
//
// Setup:
//   1. Copy this file to  Secrets.xcconfig  (same folder).
//   2. Fill in the values below.
//   3. Secrets.xcconfig is git-ignored — it never gets committed.
//
// Use the Supabase anon / public key ONLY. Never put the service_role key here.

SUPABASE_PROJECT_REF = your-project-ref
SUPABASE_ANON_KEY = your-anon-public-key

// Optional. A free OpenWeather API key (https://openweathermap.org/api).
// Leave blank to skip weather capture entirely — wear logging still works,
// it just won't record the temperature/conditions.
OPENWEATHER_API_KEY =
