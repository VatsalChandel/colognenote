// Secrets.example.xcconfig — template (committed).
//
// Setup:
//   1. Copy this file to  Secrets.xcconfig  (same folder).
//   2. Fill in the two values below from the Supabase dashboard (Settings -> API).
//   3. Secrets.xcconfig is git-ignored — it never gets committed.
//
// Use the anon / public key ONLY. Never put the service_role key here.

SUPABASE_PROJECT_REF = your-project-ref
SUPABASE_ANON_KEY = your-anon-public-key
